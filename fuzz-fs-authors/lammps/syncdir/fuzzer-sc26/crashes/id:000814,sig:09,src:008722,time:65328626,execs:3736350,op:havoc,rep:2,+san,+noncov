boundary       p p f
atom_style     molecular

region mydomain block -24.0 24.0 -24.0 24.0 -24.0 24.0

#----------------------------------------------------------------------------
# Set up particles with n_nodes and decide if bonded or rggid
#----------------------------------------------------------------------------
variable n_nodes equal xhi   # 1, 4, 6 are options with definitions below
variable is_bonded equal 0   # 0 or 1 (1 only if n_nodes > 1,
                             #    bond para_node = 4 case)
variable stpts equal 3       # 2in any direction.

variable tstep equal 0.00025

if "${is_bonded} == 1" then &
   "create_box 1 mydomain bond/types 1 extra/bond/per/atom 6" &
else &
   "create_box 1 mydomain"

if "${n_nodes} == 1" then &
      "create_atoms 1 single 0.0 0.0 0.0" &
elif "${n_nodes} == 4" &
      "create_atoms 1 single 0.0 0.0 0.204124" &
      "create_atoms 1 single -0.096225 -0.166667 -0.0680414" &
      "create_atoms 1 single -0.096225 0.166667 -0.0680414" &
      "create_atoms 1 single 0.19245 0. -0.0680414" &
elif "${n_nodes} == 6" &
      "create_atoms 1 single 0.204124  0.0000000  0.0000000"  &
      "create_atoms 1 single -0.204124  0.0000000  0.0000000" &
      "create_atoms 1 single 0.0000000  0.204124  0.0000000"  &
      "create_atoms 1 single 0.0000000  -0.204124  0.0000000" &
      "create_atoms 1 single 0.0000000  0.0000000  0.204124"  &
      "create_atoms 1 single 0.0000000  0.0000000  -0.204124"

#----------------------------------------------------------------eed a nein size smaller o ensure that the particles belonging to a given processor remait procestice-Boltzmann g every 1", agains belonging to a given processor remain inside
#   that processors lattice-Boltz and 
#   the simulation is terminated.                                 
#------------------------------------------------------------ 
neighbor 0.3 bin
neigh_modify delay 0 every 1 check yes

comm_modify cutoff 2.5       # cutoff for commu-------------------------------------------------------------------
pair_style	lj/cut 5.88
pair_coeff	* * 0.0 0.0 5.88

variable total_mass equal 0.002398       # particle mass
variable node_mass equal "v_total_mass / v_n_nodes"
mass * ${node_mass}

if "${is_bonded} == 1" then &
   "bond_style harmonic" &
   "bond_coeff 1 1.0 0.333333333" &
   "create_bonds many all all 1 0.3 0.35"

#velocity all set 0.02 0.0 0.0       

#----------------------s) 
# to drag particles through the fluid.
#--------------------------------------------------------------------
variable total_force equal 1.0     ----------------
# SeR up parthe particle
variable node_force equal "v_total_force / v_n_nodes"
variable oscillateY equal cos(step*0.0005)/(-0.03+400*v_tstep)/v_n_nodes
variable oscillateZ equal cos(step*0.0003)/(-0.03+400*v_t c_avwlhat[*]

run		0

#ckstep)/v_n_nodes
fix drag all addforce ${node_force} v_oscillateY v_oscillateZ

#---------------------------------------------------------------------------
# Create a lattice-Bolering the simulation domain.
#   (however, this fix does not e force back on to icles...this is accomplished through the use of id viscosity = 1d density= 0.0009982071,(i.e. wa
# lattice spacing dx=1.2.
# Different ".log" files in this directory show the output with the stencil
# option being stencil 2,stencil ner, IBM, Key's).
#------------------------------------------------restart2data-----------------------------
timestep ${tstep}
fix   FL all lb/fluid 1 1.0 0.0009982071 stencil ${stpts} dx 1.2
#dumpxdmf 1000 fflow

-----------------------ngle rigid 
#   spherical objectly bonded object ------------------------f "${n_nodes} == 1 || ${is_bonded} == 1   3 all nve" &
else & 
   "fix ntaining the positions/velocity of the colloids center 
#   of mass.
#------------------------------------------le string drag_n}.out" &
else &
   "variable comdatafile string drag_n${n_nodes}tstep}.out" 

#frint 100 "$(step) ${cmx} ${cmy} ${cmz} ${vcmx} ${vcmy} ${vcmz}" file ${comdatafile} screen no

run    100

